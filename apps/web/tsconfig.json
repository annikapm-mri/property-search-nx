{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@property-search/shared-contracts": ["../../libs/shared-contracts/src/index.ts"],
      "@property-search/shared-validation": ["../../libs/shared-validation/src/index.ts"],
      "@property-search/shared-types": ["../../libs/shared-types/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../../libs/shared-contracts/src",
    "../../libs/shared-validation/src",
    "../../libs/shared-types/src"
  ]
}